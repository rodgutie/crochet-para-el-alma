# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crochet_para_el_alma

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
