# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crochet_para_el_alma

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_TOKEN_EXPIRE_MINUTES=120

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Bootstrap: created automatically on first run if no admin exists
FIRST_ADMIN_EMAIL=admin@crochetparaelalma.com
FIRST_ADMIN_PASSWORD=change-me-immediately

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket: videos / PDFs / attachments
R2_BUCKET_NAME=
# PUBLIC bucket: site images uploaded from the admin (hero, products)
R2_IMAGES_BUCKET_NAME=
# Public base URL of the images bucket (r2.dev URL or custom domain, no trailing slash)
R2_PUBLIC_IMAGES_URL=https://images.crochetparaelalma.com
